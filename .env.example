DARNING_PORT=8103
# Leave blank for the local URL. Set your HTTPS address when running behind a proxy.
BANK_PUBLIC_URL=
BANK_ADMIN_USER=admin
BANK_READER_USER=
# Compose generates database credentials, the administrator password and the studio key in Docker volumes.
# Optional integration files go in api/, scan/, delivery/, studio/ or studio-mail/ under this path.
BANK_SECRETS_DIR=./.secrets
BANK_REPORT_RETENTION_DAYS=30
BANK_JOB_RETENTION_HOURS=24

# SMTP metadata. Set the password in delivery/smtp_password if SMTP uses authentication.
BANK_SMTP_HOST=
BANK_SMTP_PORT=
BANK_SMTP_FROM=
BANK_SMTP_TO=
BANK_SMTP_SECURITY=
BANK_SMTP_USER=
# Account mail settings. Store the password in delivery/account_smtp_password and studio-mail/account_smtp_password.
BANK_ACCOUNT_SMTP_HOST=
BANK_ACCOUNT_SMTP_PORT=
BANK_ACCOUNT_SMTP_FROM=
BANK_ACCOUNT_SMTP_SECURITY=
BANK_ACCOUNT_SMTP_USER=

# Default model. The API, studio and scan services read ai_key in their own secret directories.
BANK_AI_URL=
BANK_AI_MODEL=
# Exact operator-approved private origins for project model servers, separated by commas.
BANK_AI_TRUSTED_ORIGINS=
# Put the bot token in api/telegram_bot_token and studio/telegram_bot_token.
# Put the webhook secret in api/telegram_webhook_secret.
BANK_TELEGRAM_BOT_USERNAME=
# Optional private TCP forwarder to api.telegram.org, used when containers lack a direct route.
BANK_TELEGRAM_RELAY=
# Traffic statistics require a read token in studio/metrics_github_token and both allowlists.
BANK_METRICS_TRAFFIC_PROJECTS=
BANK_METRICS_TRAFFIC_REPOS=

# Optional GitHub App. Put the webhook secret in api/github_webhook_secret and the
# private key in scan/github_private_key, delivery/github_private_key and studio/github_private_key.
BANK_GITHUB_APP_ID=
BANK_GITHUB_APP_SLUG=
BANK_GITHUB_INSTALLATION_ID=
BANK_GITHUB_REPOSITORY_ID=
BANK_GITHUB_REPOSITORY=
BANK_GITHUB_PYTHON_PATH=service.py
BANK_GITHUB_CONFIG_PATH=settings.json

# Projects authorized to use the operator-configured studio SMTP destination (comma-separated IDs).
BANK_STUDIO_SMTP_PROJECTS=default
BANK_STUDIO_WEBHOOK_URL=
BANK_STUDIO_WEBHOOK_PROJECTS=
